{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.app.main:app",
      "rewrites": [{ "source": "/api/:path*", "destination": "/:path*" }],
      "functions": {
        "backend/app/main.py": { "includeFiles": "{contract/fixtures/eval.json,backend/eval/latest.json}" }
      }
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "daemons": {
    "worker": {
      "root": ".",
      "entrypoint": "backend/Dockerfile",
      "instances": { "iad1": 0 },
      "resources": { "requests": { "memory": "1Gi" } },
      "terminationGracePeriodSeconds": 60
    }
  }
}
